{
  "name": "@cluster/zk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "circuits"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "@aztec/bb.js": "0.87.0",
    "@noir-lang/noir_js": "1.0.0-beta.9",
    "@noble/curves": "^1.9.4",
    "@noble/hashes": "^1.8.0",
    "@zkpassport/poseidon2": "^0.6.0",
    "@stellar/stellar-sdk": "15.1.0"
  },
  "devDependencies": {
    "@cluster/config": "*",
    "tsup": "^8.3.0",
    "typescript": "^5.8.0",
    "vitest": "^2.1.0"
  }
}
