# ──────────────────────────────────────────────────────────────────────────────
# Cluster Web — environment
# NEXT_PUBLIC_* values are exposed to the browser. Do NOT put secrets here.
# Copy to apps/web/.env.local for local development.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of the NestJS API (requests use withCredentials for the session cookie)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Active Stellar network: "mainnet" (default — real funds) or "testnet".
# Must match the API's STELLAR_NETWORK, and the URLs below must point at it.
NEXT_PUBLIC_STELLAR_NETWORK=mainnet

# Stellar Horizon endpoint for the network above
NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org

# Stellar RPC endpoint for the network above — used client-side to load
# sequence numbers and submit the create-account transaction. On mainnet use a
# provider-specific RPC URL (https://developers.stellar.org/docs/data/apis/rpc/providers);
# on testnet, https://soroban-testnet.stellar.org.
NEXT_PUBLIC_STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
