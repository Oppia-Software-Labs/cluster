# ──────────────────────────────────────────────────────────────────────────────
# Cluster Web — environment (MAINNET ONLY)
# NEXT_PUBLIC_* values are exposed to the browser. Do NOT put secrets here.
# Copy to apps/web/.env.local for local development.
# ──────────────────────────────────────────────────────────────────────────────

# Base URL of the NestJS API (requests use withCredentials for the session cookie)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Stellar network — locked to mainnet
NEXT_PUBLIC_STELLAR_NETWORK=mainnet

# Stellar Horizon endpoint (mainnet)
NEXT_PUBLIC_HORIZON_URL=https://horizon.stellar.org

# Stellar RPC endpoint (mainnet) — used client-side to load sequence numbers and
# submit the create-account transaction. Use a provider-specific mainnet RPC URL
# (https://developers.stellar.org/docs/data/apis/rpc/providers).
NEXT_PUBLIC_STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
