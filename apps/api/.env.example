# Port the NestJS API listens on
PORT=3001
# Origin allowed by CORS (the Next.js frontend)
WEB_ORIGIN=http://localhost:3000
# Supabase Postgres — pooled (runtime) + direct (migrations)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Session JWT signing secret (min 32 chars)
JWT_SECRET=replace-with-a-long-random-secret-32-chars-min
# Set true in production (HTTPS) so the session cookie is Secure
COOKIE_SECURE=false
# Active Stellar network: "mainnet" (default — real funds) or "testnet".
# The passphrase is derived from this; RPC + Horizon below must match it.
STELLAR_NETWORK=mainnet
STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
STELLAR_HORIZON_URL=https://horizon.stellar.org
# For testnet use e.g.:
#   STELLAR_RPC_URL=https://soroban-testnet.stellar.org
#   STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Optional testnet RPC override — only needed on mainnet, for transactions that
# explicitly target testnet (DeFindex testnet vaults)
STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
# DeFindex API key (https://api.defindex.io) — server-side only, never sent to the browser
DEFINDEX_API_KEY=replace-with-your-defindex-api-key
# Confidential-token contracts (Stellar testnet)
CONFIDENTIAL_TOKEN_CONTRACT_ID=CAPLH4ZW7EDSYRBCQN77Y4K7W5RNA6TO76JQ5CGHHIPY4ALWVQZ2WFAY
CONFIDENTIAL_VERIFIER_CONTRACT_ID=CC6NG5LWW6QA4YSW2RP7RR2CE5FF6IHAGJEYY4STG6QP563EWSZU5DG7
CONFIDENTIAL_AUDITOR_CONTRACT_ID=CAEYYDRJPJ73UR3UZWYLSIWW4CHUZILTSENAWOUYXGSR4LPY4HQ23R4L
# Stellar Asset Contract for the underlying token being wrapped
CONFIDENTIAL_UNDERLYING_SAC=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Index of the auditor key in the on-chain auditor registry
CONFIDENTIAL_AUDITOR_ID=0
